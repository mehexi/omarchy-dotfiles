{
  "bar": {
    "id": "mehexi.bar",
    "layout": {
      "center": [],
      "left": [
        {
          "id": "omarchy.menu",
          "joinNext": true
        },
        {
          "id": "mehexi.app-name",
          "joinPrev": true
        }
      ],
      "right": [
        {
          "id": "mehexi.tray"
        },
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "omarchy.workspaces"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "mehexi.weather"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.bluetooth",
          "hidden": true
        },
        {
          "id": "omarchy.network",
          "hidden": true
        },
        {
          "id": "omarchy.audio",
          "hidden": true
        },
        {
          "id": "omarchy.monitor",
          "hidden": true
        },
        {
          "id": "omarchy.power",
          "hidden": true
        },
        {
          "exec": "~/.config/omarchy/bar/scripts/daily-schedule",
          "id": "daily-schedule",
          "interval": 30,
          "onClick": "~/.config/omarchy/bar/scripts/daily-schedule notify",
          "tooltip": "Daily schedule",
          "type": "command",
          "swapOnHover": true
        },
        {
          "format": "ddd d MMM HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "mehexi.clock",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "mehexi.bt-battery"
        },
        {
          "id": "disk-usage",
          "type": "command",
          "exec": "~/.config/omarchy/bar/scripts/disk-usage",
          "interval": 60,
          "tooltip": "Disk usage",
          "onClick": "~/.config/omarchy/bar/scripts/disk-usage notify",
          "onRightClick": "omarchy-launch-terminal btop"
        },
        {
          "id": "mehexi.phone"
        },
        {
          "id": "omarchy.elsewhen",
          "cities": [
            {
              "name": "Dhaka",
              "zone": "Asia/Dhaka"
            },
            {
              "name": "Tokyo",
              "zone": "Asia/Tokyo"
            },
            {
              "name": "Los Angeles",
              "zone": "America/Los_Angeles"
            },
            {
              "name": "New York",
              "zone": "America/New_York"
            },
            {
              "name": "London",
              "zone": "Europe/London"
            }
          ]
        },
        {
          "id": "mehexi.control-center",
          "pill": false
        }
      ],
      "centerBegin": [],
      "centerEnd": [],
      "tray": []
    },
    "position": "top",
    "transparent": false
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "mehexi.launchpad"
    },
    {
      "id": "mehexi.lock"
    },
    {
      "id": "mehexi.dock"
    }
  ],
  "version": 1,
  "disabledPlugins": [
    "omarchy.lock"
  ],
  "cloneSourceRestores": [
    "mehexi.lock"
  ]
}
